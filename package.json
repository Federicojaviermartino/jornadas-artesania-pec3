{
  "name": "jornadas-artesania-pec3",
  "version": "1.0.0",
  "private": true,
  "description": "Jornadas de Artesania - sitio web de las jornadas municipales sobre artesania",
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "dev": "npm-run-all clean parcel:serve",
    "build": "npm-run-all clean parcel:build",
    "test": "echo 'Everything is working as expected'"
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": [
        "src/index.html",
        "src/ponentes.html",
        "src/concurso.html"
      ],
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Federicojaviermartino/jornadas-artesania-pec3.git"
  },
  "author": {
    "name": "Federico Javier Martino"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Federicojaviermartino/jornadas-artesania-pec3/issues"
  },
  "homepage": "https://github.com/Federicojaviermartino/jornadas-artesania-pec3#readme",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.3",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.3",
    "postcss-preset-env": "^11.1.2",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@fortawesome/fontawesome-free": "^7.2.0"
  }
}
